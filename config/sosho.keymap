//スクロール量の調整(デフォルト150)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

/ {
	behaviors {
        ec_ms_l: ec_ms_h {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
        ec_ms_r: ec_ms_v {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
		my_lt: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap";
        };
    };
};

//スクロールの調整
&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};

/{
    combos {
        compatible = "zmk,combos";

		//左カーソルのコンボ 19はJのキー 20はKのキーに相当します。
	    combo_LEFT {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&kp LEFT>;
        };

		//右カーソルのコンボ 20 K 21 L
        combo_RIGHT {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&kp RIGHT>;
        };

		//上カーソルのコンボ 7 8
        combo_UP {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&kp UP>;
        };

		//下カーソルのコンボ 30 K 31 L
        combo_DOWN {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&kp DOWN>;
        };

		//ホイールクリックのコンボ 32 33
	    combo_MCLK {
            timeout-ms = <90>;
            key-positions = <32 33>;
            bindings = <&mkp MCLK>;
        };

		//バックスペースのコンボ 8 9 
	    combo_BSPC {
            timeout-ms = <90>;
            key-positions = <8 9>;
            bindings = <&kp BSPC>;
        };

		//デリートのコンボ 30 31
	    combo_DEL {
            timeout-ms = <90>;
            key-positions = <30 31>;
            bindings = <&kp DEL>;
        };

		//エスケープのコンボ 27 28
	    combo_ESC {
            timeout-ms = <90>;
            key-positions = <27 28>;
            bindings = <&kp ESC>;
        };

		//アンダースコアのコンボ 16 7
	    combo_UNDER {
            timeout-ms = <90>;
            key-positions = <16 7>;
            bindings = <&kp UNDER>;
        };

		//カンマのコンボ 16 32
	    combo_COMMA {
            timeout-ms = <90>;
            key-positions = <16 32>;
            bindings = <&kp COMMA>;
        };

		//DOTのコンボ 16 33
	    combo_DOT {
            timeout-ms = <90>;
            key-positions = <16 33>;
            bindings = <&kp DOT>;
        
    };
};


/{
keymap {
    compatible = "zmk,keymap";

    default_layer {
        bindings = <
            &kp TAB    &kp Q   &kp W  &kp E  &kp R  &kp T        &kp Y  &kp U  &kp I      &kp O      &kp P     &kp LA(GRAVE) 
            &kp LCTRL  &kp A   &kp S  &kp D  &kp F  &kp G        &kp H  &kp J  &kp K      &kp L      &kp SQT   &kp ENTER
            &kp LSHFT  &kp Z   &kp X  &kp C  &kp V  &kp B        &kp N  &kp M  &mkp LCLK  &mkp RCLK  &kp SLASH &kp LSHFT
            &kp ESC    &kp LGUI              &kp LALT &kp SPACE  &mo 2  &my_lt 1 SPACE               &mo 3     &kp LCTRL
        >;
		//&ec_ms_lとrは、上のビヘイビアで作ったもの。
        sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
    };
	
    layer_1 {
        bindings = <
            &kp GRAVE &kp N1  &kp N2  &kp N3  &kp N4  &kp N5       &kp N6    &kp N7   &kp N8   &kp N9    &kp N0   &kp DEL
            &trans    &trans &trans &trans &trans &trans           &trans    &trans   &trans   &trans    &trans   &trans &trans
            &trans    &trans &trans &trans &trans &trans           &trans    &trans   &trans   &trans    &trans   &trans
            &trans    &trans               &trans &trans           &trans    &trans                      &trans    &trans
        >;
    };

    layer_2 {
        bindings = <
            &trans &kp F1  &kp F2  &kp F3  &kp F4  &kp F5     &kp F6  &kp F7    &kp F8   &kp F9    &kp F10    &kp F11
            &&trans    &trans &trans &trans &trans &trans     &trans  &trans    &trans   &trans    &trans     &kp F12
            &trans &kp F11 &kp F12 &kp F13 &kp F14 &kp F15    &trans  &trans    &trans   &trans    &trans     &trans
            &trans &trans                  &trans  &trans     &trans  &trans                       &trans     &trans
        >;
		//レイヤー2のときだけ、左手のエンコーダを回すとボリュームの上下ができるようになっています。
		sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &ec_ms_r SCRL_DOWN SCRL_UP>;

    };

    layer_3 {
        bindings = <
            &trans &trans &trans &trans &trans &trans      &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4
            &trans &trans &trans &trans &trans &trans      &trans  &trans        &trans        &trans        &trans         &trans
            &trans &trans &trans &trans &trans &trans      &trans  &trans        &trans        &trans        &bt BT_CLR_ALL &bt BT_CLR
            &trans &trans               &trans &trans      &trans  &out OUT_BLE                                    &trans         &trans
        >;
    };
    scroll {
        status = "reserved";
    };

    extra2 {
        status = "reserved";
    };
};
};
